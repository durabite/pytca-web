---
---
<section class="py-margin-lg bg-surface-container-lowest" id="contact">
  <div class="max-w-7xl mx-auto px-gutter">
    <div class="bg-background p-margin-md border-2 border-outline-variant relative overflow-hidden">
      <!-- Background Decoration -->
      <div class="absolute -right-20 -bottom-20 opacity-5 pointer-events-none select-none">
        <span class="font-display-lg text-[250px] uppercase text-white">CONTACTO</span>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-margin-lg relative z-10">
        <!-- Columna Izquierda: Introducción -->
        <div>
          <h2 class="font-headline-lg text-headline-lg uppercase text-primary mb-gutter">Contacto</h2>
          <p class="font-body-md text-on-surface-variant max-w-md">
            Solicite su cotización hoy mismo. Nuestro equipo técnico está listo para atender sus necesidades de suministro de agua potable, terracerías y obra civil de forma inmediata.
          </p>
        </div>
        
        <!-- Columna Derecha: Datos de Contacto -->
        <div class="space-y-8 lg:pl-gutter lg:border-l border-outline-variant">
          <!-- Ubicación (oculto temporalmente hasta recibir información oficial)
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary !text-3xl">location_on</span>
            <div>
              <h5 class="font-label-md text-label-md uppercase text-white">Ubicación</h5>
              <p class="font-body-md text-on-surface-variant">Av. Industrial 123, Zona Centro<br />Ciudad de México, México</p>
            </div>
          </div>
          -->
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary !text-3xl">phone_in_talk</span>
            <div>
              <h5 class="font-label-md text-label-md uppercase text-white">Teléfono</h5>
              <p class="font-body-md text-on-surface-variant">
                <a href="tel:+525532250048" class="hover:text-primary transition-colors">+52 (55) 3225 0048</a>
              </p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-primary !text-3xl">mail</span>
            <div>
              <h5 class="font-label-md text-label-md uppercase text-white">Email</h5>
              <p class="font-body-md text-on-surface-variant">
                <a href="mailto:pytcasadecv@hotmail.com" class="hover:text-primary transition-colors">pytcasadecv@hotmail.com</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
