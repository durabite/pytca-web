          class="bg-primary-container text-on-primary-container px-10 py-5 font-headline-md text-headline-md uppercase flex items-center justify-center gap-4 hover:bg-white hover:text-black transition-all group duration-300"
        >
          Solicitar Pipa
          <span class="material-symbols-outlined group-hover:translate-x-2 transition-transform">arrow_forward</span>
        </a>
        <!--
        <div class="flex items-center justify-center gap-4 border-2 border-outline-variant px-6 py-5">
          <span class="font-label-md text-label-md text-primary uppercase">Estatus del Servicio:</span>
          <span class="font-label-md text-label-md text-white">OPERATIVO</span>
          <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
        </div>
        -->
      </div>
    </div>
  </div>
</section>
