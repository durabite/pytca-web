---
---
<section class="py-margin-lg bg-surface industrial-grid" id="services">
  <div class="max-w-7xl mx-auto px-gutter">
    <div class="flex justify-between items-end mb-margin-md border-b-2 border-outline-variant pb-stack-compact">
      <h2 class="font-headline-lg text-headline-lg uppercase text-white">Nuestros Servicios</h2>
      <span class="font-label-md text-label-md text-primary pb-1">CATÁLOGO DE SERVICIOS</span>
    </div>
    
    <div class="mb-margin-lg border border-outline-variant bg-surface-container-low p-gutter relative overflow-hidden">
      <!-- Decoración industrial de fondo -->
      <div class="absolute right-0 top-0 opacity-5 pointer-events-none select-none">
        <span class="font-display-lg text-[120px] uppercase text-white">AGUA</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-gutter items-start relative z-10">
        <!-- Columna Izquierda: Título y Descripción -->
        <div class="space-y-4">
          <h3 class="font-headline-lg text-headline-lg text-white uppercase leading-tight">
            Suministro y Traslado de Agua Potable en Pipas
          </h3>
          <p class="font-body-md text-on-surface-variant">
            Contamos con el servicio de distribución de agua potable para todo tipo de necesidades. Nuestras unidades cumplen con las normas de higiene necesarias para garantizar un elemento limpio y seguro.
          </p>
          
          <!-- Capacidades y especificaciones -->
          <div class="mt-6 space-y-4">
            <h4 class="font-headline-md text-[20px] text-white uppercase tracking-wider">
              Pipas de agua
            </h4>
            <div class="grid grid-cols-2 gap-4">
              <div class="border-2 border-primary-container p-4 text-center bg-surface-container-high">
                <span class="font-display-lg text-3xl md:text-4xl text-primary-container block font-black">10,000</span>
                <span class="font-label-md text-xs uppercase text-on-surface-variant">Litros</span>
              </div>
              <div class="border-2 border-primary-container p-4 text-center bg-surface-container-high">
                <span class="font-display-lg text-3xl md:text-4xl text-primary-container block font-black">20,000</span>
                <span class="font-label-md text-xs uppercase text-on-surface-variant">Litros</span>
              </div>
            </div>
            <div class="font-label-md text-sm text-primary uppercase tracking-[0.2em] font-bold">
              Agua Potable
            </div>
          </div>
        </div>
        <!-- Columna Derecha: Ideal Para y Botón Cotizar -->
        <div class="space-y-6 lg:pl-gutter lg:border-l border-outline-variant h-full flex flex-col justify-between">
          <div class="space-y-2">
            <h4 class="font-label-md text-label-md uppercase text-primary tracking-wider">Ideal para:</h4>
            <ul class="space-y-1 font-body-md text-white">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Industrias</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Obras de construcción</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Comercios</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Hoteles</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Complejos residenciales</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0"></span> Eventos especiales</li>
            </ul>
          </div>
          <div>
            <a 
              href="https://wa.me/525532250048?text=Hola,%20me%20pongo%20en%20contacto%20desde%20su%20sitio%20web.%20Me%20gustar%C3%ADa%20solicitar%20una%20cotizaci%C3%B3n%20para%20el%20servicio%20de%20suministro%20de%20agua%20potable%20con%20pipa%20de%20PYTCA." 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex bg-[#25D366] text-white font-headline-md text-headline-md uppercase px-8 py-4 active:scale-95 duration-150 transition-all hover:bg-[#20ba5a] items-center gap-2"
            >
              <svg class="w-6 h-6 fill-current shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.012 2c-5.506 0-9.988 4.482-9.988 9.988 0 1.76.459 3.473 1.33 4.986l-1.413 5.163 5.283-1.386c1.465.798 3.11 1.22 4.787 1.222h.004c5.503 0 9.988-4.482 9.988-9.988C22 6.482 17.518 2 12.012 2zm6.046 14.184c-.267.753-1.282 1.38-1.782 1.488-.475.103-.984.18-2.906-.576-2.457-.968-4.04-3.468-4.162-3.632-.123-.162-1.006-1.34-1.006-2.559 0-1.218.636-1.817.863-2.062.227-.246.49-.307.653-.307.164 0 .327.002.47.01.146.008.342-.057.535.41.2.484.685 1.677.747 1.802.06.122.1.265.02.427-.083.165-.125.267-.25.41-.122.146-.26.326-.37.44-.122.12-.25.253-.105.502.143.248.633 1.043 1.36 1.69.93.83 1.71 1.087 1.954 1.21.244.12.387.1.529-.06.142-.164.61-.71.774-.95.164-.242.327-.203.55-.122.223.082 1.416.668 1.66.79.245.123.408.183.468.287.06.102.06.593-.207 1.346z"/>
              </svg>
              Cotizar Servicio de Agua
            </a>
          </div>
        </div>
      </div>

      <!-- Carrusel de imágenes -->
      <div class="relative group/carousel mt-6 border-t border-outline-variant pt-6">
        <div class="flex justify-between items-center mb-4">
          <span class="font-label-md text-label-md text-on-surface-variant">GALERÍA DE UNIDADES</span>
          <div class="flex gap-2">
            <button 
              id="carousel-prev" 
              class="border border-outline-variant hover:border-primary hover:text-primary text-white p-2 duration-150 transition-all active:scale-90 cursor-pointer"
              aria-label="Imagen anterior"
            >
              <span class="material-symbols-outlined block">chevron_left</span>
            </button>
            <button 
              id="carousel-next" 
              class="border border-outline-variant hover:border-primary hover:text-primary text-white p-2 duration-150 transition-all active:scale-90 cursor-pointer"
              aria-label="Siguiente imagen"
            >
              <span class="material-symbols-outlined block">chevron_right</span>
            </button>
          </div>
        </div>

        <!-- Track del carrusel -->
        <div 
          id="carousel-track" 
          class="flex gap-4 overflow-x-auto snap-x snap-mandatory scrollbar-none scroll-smooth scroll-padding-gutter pb-4"
        >
          <!-- Imagen 1 a 11 -->
          {
            Array.from({ length: 11 }, (_, i) => i + 1).map((num) => (
              <div class="snap-start shrink-0 w-[280px] md:w-[380px] aspect-[4/3] border border-outline-variant bg-surface-container relative overflow-hidden group/item">
                <img 
                  class="w-full h-full object-cover grayscale group-hover/item:grayscale-0 group-hover/item:scale-105 transition-all duration-500" 
                  alt={`Unidad de suministro de agua potable - Pipa ${num}`}
                  src={`/image/carrousel-pipas/pipa-${num}.jpeg`}
                  loading="lazy"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Servicios -->
    <div class="flex justify-between items-end mb-margin-md border-b-2 border-outline-variant pb-stack-compact">
      <h3 class="font-headline-md text-headline-md uppercase text-white">Servicios</h3>
      <span class="font-label-md text-label-md text-primary pb-1">CATÁLOGO DE OBRA Y SUMINISTRO</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <!-- Obra Civil -->
      <div class="lg:col-span-4 md:col-span-6 group relative overflow-hidden bg-surface-container-low border border-outline-variant hover:border-primary transition-all duration-300 p-gutter h-[350px]">
        <div class="relative z-10 flex flex-col h-full justify-center">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-[2px] bg-primary"></span>
            <h3 class="font-headline-md text-headline-md uppercase text-white text-left">Obra Civil</h3>
          </div>
          <p class="font-body-md text-on-surface-variant max-w-md">Albañilería, estructuras de concreto y metálicas.</p>
        </div>
        <img 
          class="absolute inset-0 w-full h-full object-cover opacity-10 group-hover:opacity-30 transition-all duration-700" 
          alt="Obra Civil" 
          src="/image/bg-servicios/obra-civil-pytca.jpeg"
        />
      </div>
      
      <!-- Acabados -->
      <div class="lg:col-span-4 md:col-span-6 group relative overflow-hidden bg-surface-container-low border border-outline-variant hover:border-primary transition-all duration-300 p-gutter h-[350px]">
        <div class="relative z-10 flex flex-col h-full justify-center">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-[2px] bg-primary"></span>
            <h3 class="font-headline-md text-headline-md uppercase text-white text-left">Acabados</h3>
          </div>
          <p class="font-body-md text-on-surface-variant max-w-md">Tabla roca, pintura, pisos, carpintería, herrería, cancelería e impermeabilización.</p>
        </div>
        <img 
          class="absolute inset-0 w-full h-full object-cover opacity-10 group-hover:opacity-30 transition-all duration-700" 
          alt="Acabados" 
          src="/image/bg-servicios/acabados-pytca.jpeg"
        />
      </div>
      
      <!-- Instalaciones -->
      <div class="lg:col-span-4 md:col-span-12 group relative overflow-hidden bg-surface-container-low border border-outline-variant hover:border-primary transition-all duration-300 p-gutter h-[350px]">
        <div class="relative z-10 flex flex-col h-full justify-center">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-[2px] bg-primary"></span>
            <h3 class="font-headline-md text-headline-md uppercase text-white text-left">Instalaciones</h3>
          </div>
          <p class="font-body-md text-on-surface-variant max-w-md">Hidrosanitarias y eléctricas.</p>
        </div>
        <img 
          class="absolute inset-0 w-full h-full object-cover opacity-10 group-hover:opacity-30 transition-all duration-700" 
          alt="Instalaciones" 
          src="/image/bg-servicios/instalaciones-pytca.jpeg"
        />
      </div>
      
      <!-- Urbanización -->
      <div class="lg:col-span-6 md:col-span-6 group relative overflow-hidden bg-surface-container-low border border-outline-variant hover:border-primary transition-all duration-300 p-gutter h-[350px]">
        <div class="relative z-10 flex flex-col h-full justify-center">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-[2px] bg-primary"></span>
            <h3 class="font-headline-md text-headline-md uppercase text-white text-left">Urbanización</h3>
          </div>
          <ul class="space-y-1 font-body-md text-on-surface-variant max-w-md">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0 mt-2"></span> Cruces de autopistas y vialidades por el procedimiento de Tunnel Liner.</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0 mt-2"></span> Hincado de tubería para construcción de colectores y cruces de autopistas, vías de FFCC e instalaciones diversas.</li>
          </ul>
        </div>
        <img 
          class="absolute inset-0 w-full h-full object-cover opacity-10 group-hover:opacity-30 transition-all duration-700" 
          alt="Urbanización" 
          src="/image/bg-servicios/urbanizacion-pytca.jpeg"
        />
      </div>
      
      <!-- Otros -->
      <div class="lg:col-span-6 md:col-span-6 group relative overflow-hidden bg-surface-container-low border border-outline-variant hover:border-primary transition-all duration-300 p-gutter h-[350px]">
        <div class="relative z-10 flex flex-col h-full justify-center">
          <div class="flex items-center gap-4 mb-4">
            <span class="w-12 h-[2px] bg-primary"></span>
            <h3 class="font-headline-md text-headline-md uppercase text-white text-left">Otros</h3>
          </div>
          <ul class="space-y-1 font-body-md text-on-surface-variant max-w-md">
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0 mt-2"></span> Suministro y traslado de agregados.</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0 mt-2"></span> Retiro de escombros.</li>
            <li class="flex items-start gap-2"><span class="w-1.5 h-1.5 bg-primary shrink-0 mt-2"></span> Renta de maquinaria.</li>
          </ul>
        </div>
        <img 
          class="absolute inset-0 w-full h-full object-cover opacity-10 group-hover:opacity-30 transition-all duration-700" 
          alt="Otros" 
          src="/image/bg-servicios/otros-pytca.jpeg"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // Script para scroll de carrusel de unidades
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');

  if (track && prevBtn && nextBtn) {
    const scrollAmount = 320;
    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });
  }
</script>

