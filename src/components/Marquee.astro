<section class="bg-surface-container-lowest border-y-4 border-primary py-margin-md overflow-hidden relative">
  <div class="flex whitespace-nowrap animate-marquee">
    <!-- First block of content -->
    <div class="flex gap-margin-lg items-center px-gutter shrink-0">
      <span class="font-display-lg text-headline-lg uppercase text-primary">Servicios Adicionales</span>
      <span class="material-symbols-outlined text-white !text-4xl">settings</span>
      <span class="font-headline-md text-headline-md uppercase text-white">Suministro de Agregados</span>
      <span class="w-4 h-4 bg-primary rotate-45"></span>
      <span class="font-headline-md text-headline-md uppercase text-white">Retiro de Escombros</span>
      <span class="w-4 h-4 bg-primary rotate-45"></span>
      <span class="font-headline-md text-headline-md uppercase text-white">Renta de Maquinaria</span>
      <span class="w-4 h-4 bg-primary rotate-45"></span>
    </div>
    <!-- Duplicate block of content for seamless looping -->
    <div class="flex gap-margin-lg items-center px-gutter shrink-0" aria-hidden="true">
      <span class="font-display-lg text-headline-lg uppercase text-primary">Servicios Adicionales</span>
      <span class="material-symbols-outlined text-white !text-4xl">settings</span>
      <span class="font-headline-md text-headline-md uppercase text-white">Suministro de Agregados</span>
      <span class="w-4 h-4 bg-primary rotate-45"></span>
      <span class="font-headline-md text-headline-md uppercase text-white">Retiro de Escombros</span>
